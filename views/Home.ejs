<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestor de Tareas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            color: #1e293b; 
            -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4, h5, h6, .navbar-brand, .nav-link {
            letter-spacing: -0.02em;
        }
        .navbar-custom { 
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1); 
            border-bottom: 3px solid #3b82f6;
        }
        .navbar-nav .nav-link {
            font-weight: 500;
            color: #e2e8f0 !important;
            transition: color 0.2s;
        }
        .navbar-nav .nav-link:hover, .navbar-nav .nav-link.active {
            color: #ffffff !important;
            font-weight: 700;
        }
        .card-feature { 
            border-radius: 16px; 
            border: 1px solid #e2e8f0; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.02); 
            transition: all 0.3s ease; 
            background: #ffffff;
        }
        .card-feature:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 12px 25px -5px rgba(59, 130, 246, 0.15); 
            border-color: #93c5fd;
        }
        .bg-primary-custom { 
            background-color: #0f172a !important; 
        }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold fs-5" href="/"><i class="bi bi-kanban-fill me-2 text-primary"></i> Gestor de Tareas</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item"><a class="nav-link active" href="/">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="/tareas/crear">Tareas</a></li>
                <li class="nav-item"><a class="nav-link" href="/ListaTareas">Lista Tareas</a></li>
                <li class="nav-item"><a class="nav-link" href="/ListaOrganizaciones">Organizaciones</a></li>
                <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios</a></li>
                <% if(typeof usuario !== 'undefined' && usuario) { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-light fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> <%= usuario.nombre_completo || usuario.correo %> 
                            <span class="badge bg-primary ms-1"><%= usuario.rol %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item text-danger fw-semibold" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                        </ul>
                    </li>
                <% } else { %>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/auth/login">Login</a></li>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/auth/registro">Registro</a></li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
<main class="container-fluid px-0 overflow-hidden bg-white">
    <section class="py-5 my-3 text-center">
        <div class="container">
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill mb-3 fw-bold small shadow-sm">
                ✨ VERSION BETA ABIERTA✨
            </span>
            <h1 class="display-5 fw-bolder text-dark tracking-tight mb-3" style="letter-spacing: -0.03em;">GESTIÓN DE TAREAS OPERATIVAS</h1>
            <p class="lead text-secondary max-w-xl mx-auto mb-0 fs-6 fw-medium">
                UNA FORMA SENCILLA, LIMPIA Y EFICIENTE DE GESTIONAR TAREAS, ORGANIZACIONES Y USUARIOS.
            </p>
        </div>
    </section>
    <section class="container pb-5 mb-5">
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="card card-feature border-0 bg-light rounded-4 overflow-hidden h-100">
                    <div class="p-3 pb-0">
                        <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=600&q=80" alt="Seguridad" class="w-100 rounded-3 object-fit-cover" style="height: 140px;">
                    </div>
                    <div class="card-body p-4 text-start">
                        <h5 class="fw-bolder text-dark mb-1">SEGURIDAD Y ROLES</h5>
                        <p class="text-secondary small mb-0 fw-semibold">CONTROL DE ACCESOS Y PERFILES POR USUARIO</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-feature border-0 bg-light rounded-4 overflow-hidden h-100">
                    <div class="p-3 pb-0">
                        <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=600&q=80" alt="Trazabilidad" class="w-100 rounded-3 object-fit-cover" style="height: 140px;">
                    </div>
                    <div class="card-body p-4 text-start">
                        <h5 class="fw-bolder text-dark mb-1">TRAZABILIDAD TOTAL</h5>
                        <p class="text-secondary small mb-0 fw-semibold">REGISTRO AUDITABLE DE PROCESOS</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-feature border-0 bg-light rounded-4 overflow-hidden h-100">
                    <div class="p-3 pb-0">
                        <img src="https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?auto=format&fit=crop&w=600&q=80" alt="Monitoreo" class="w-100 rounded-3 object-fit-cover" style="height: 140px;">
                    </div>
                    <div class="card-body p-4 text-start">
                        <h5 class="fw-bolder text-dark mb-1">MONITOREO EN TIEMPO REAL</h5>
                        <p class="text-secondary small mb-0 fw-semibold">SEGUIMIENTO DE ESTADOS Y AVANCES</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
<footer class="footer mt-auto py-4 bg-primary-custom text-white text-center border-top border-dark">
    <div class="container">
        <p class="mb-1 fw-bold">&copy; 2026 Sistema de Gestión de Tareas Operativas</p>
        <p class="mb-2 fw-medium">
            <i class="bi bi-calendar-check me-1 text-info"></i> Fecha del sistema: <span id="fechaActual" class="fw-bold"></span>
        </p>
        <p class="small text-white-50 mb-0 fw-semibold">Control • Seguridad • Reportes</p>
    </div>
</footer>
<script>
    function actualizarFecha() {
        const fecha = new Date();
        const opciones = {
            year: 'numeric', month: 'long', day: 'numeric',
            hour: '2-digit', minute: '2-digit', second: '2-digit'
        };
        const fechaFormateada = fecha.toLocaleString('es-CL', opciones);
        const elementoFecha = document.getElementById("fechaActual");
        if (elementoFecha) {
            elementoFecha.textContent = fechaFormateada;
        }
    }
    actualizarFecha();
    setInterval(actualizarFecha, 1000);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>