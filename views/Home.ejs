<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestor de Tareas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', sans-serif;
            background: #f8fafc; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            color: #334155;
        }
        .navbar-custom { 
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1); 
            border-bottom: 3px solid #3b82f6;
        }
        .hero-section { 
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); 
            border-radius: 16px; 
            padding: 40px; 
            color: white; 
            margin-bottom: 30px; 
            box-shadow: 0 10px 25px -5px rgba(30, 58, 138, 0.2);
        }
        .card-feature { 
            border-radius: 16px; 
            border: 1px solid #e2e8f0; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.02); 
            transition: all 0.3s ease; 
            background: #ffffff;
        }
        .card-feature:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 12px 25px -5px rgba(59, 130, 246, 0.15); 
            border-color: #93c5fd;
        }
        .bg-primary-custom { 
            background-color: #0f172a !important; 
        }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-semibold" href="/"><i class="bi bi-kanban-fill me-2 text-primary"></i> Gestor de Tareas</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item"><a class="nav-link active" href="/">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="/tareas">Tareas</a></li>
                <li class="nav-item"><a class="nav-link" href="/ListaOrganizaciones">Organizaciones</a></li>
                <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios</a></li>
                <% if(typeof usuario !== 'undefined' && usuario) { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-light fw-medium" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> <%= usuario.nombre_completo || usuario.correo %> 
                            <span class="badge bg-secondary ms-1"><%= usuario.rol %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item text-danger fw-medium" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                        </ul>
                    </li>
                <% } else { %>
                    <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="/auth/registro">Registro</a></li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
<main class="container my-5">
    <div class="hero-section">
        <h1 class="display-5 fw-bold tracking-tight">Gestión de Tareas Operativas</h1>
        <p class="lead text-white-50 mb-0">Plataforma centralizada en la gestión de Tareas en Organizaciones</p>
    </div>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card card-feature p-4 text-center h-100">
                <div class="my-2">
                    <i class="bi bi-shield-check display-4 text-primary"></i>
                </div>
                <h5 class="mt-3 fw-bold text-dark">Seguridad y Roles</h5>
                <p class="text-muted small mb-0">Control de accesos y perfiles.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-feature p-4 text-center h-100">
                <div class="my-2">
                    <i class="bi bi-graph-up-arrow display-4 text-success"></i>
                </div>
                <h5 class="mt-3 fw-bold text-dark">Trazabilidad Total</h5>
                <p class="text-muted small mb-0">Registro auditable de acciones.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-feature p-4 text-center h-100">
                <div class="my-2">
                    <i class="bi bi-clock-history display-4 text-warning"></i>
                </div>
                <h5 class="mt-3 fw-bold text-dark">Monitoreo en Tiempo Real</h5>
                <p class="text-muted small mb-0">Seguimiento de estados y avances.</p>
            </div>
        </div>
    </div>
</main>
<footer class="footer mt-auto py-4 bg-primary-custom text-white text-center border-top border-dark">
    <div class="container">
        <p class="mb-1 fw-medium">&copy; 2026 Sistema de Gestión de Tareas Operativas</p>
        <p class="mb-2">
            <i class="bi bi-calendar-check me-1 text-info"></i> Fecha del sistema: <span id="fechaActual" class="fw-bold"></span>
        </p>
        <p class="small text-white-50 mb-0">Control • Seguridad • Reportes</p>
    </div>
</footer>
<script>
    function actualizarFecha() {
        const fecha = new Date();
        const opciones = {
            year: 'numeric', month: 'long', day: 'numeric',
            hour: '2-digit', minute: '2-digit', second: '2-digit'
        };
        const fechaFormateada = fecha.toLocaleString('es-CL', opciones);
        const elementoFecha = document.getElementById("fechaActual");
        if (elementoFecha) {
            elementoFecha.textContent = fechaFormateada;
        }
    }
    actualizarFecha();
    setInterval(actualizarFecha, 1000);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>