<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestor de Tareas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: #f0f2f5; min-height: 100vh; display: flex; flex-direction: column; }
        .navbar-custom { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
        .hero-section { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 20px; padding: 40px; color: white; margin-bottom: 30px; }
        .card-feature { border-radius: 18px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: 0.3s; }
        .card-feature:hover { transform: translateY(-10px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        /* Footer personalizado */
        .bg-primary-custom { background-color: #1e3c72; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="bi bi-kanban-fill me-2"></i> Gestor de Tareas</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link active" href="/">Inicio</a></li>
                <% if(usuario) { %>
                    <li class="nav-item"><a class="nav-link" href="/tareas">Tareas</a></li>
                    <li class="nav-item"><a class="nav-link text-danger" href="/auth/logout">Cerrar Sesión</a></li>
                <% } else { %>
                    <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="/auth/registro">Registro</a></li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>

<main class="container my-4">
    <div class="hero-section">
        <h1 class="display-5 fw-bold">Gestión de Tareas Operativas</h1>
        <p class="lead">Plataforma centralizada en la gestión de Tareas en Organizaciones</p>
    </div>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card card-feature p-4 text-center">
                <i class="bi bi-shield-check display-4 text-primary"></i>
                <h5 class="mt-3">Seguridad y Roles</h5>
                <p class="text-muted">Gestión de accesos y permisos basada en perfiles</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-feature p-4 text-center">
                <i class="bi bi-graph-up-arrow display-4 text-success"></i>
                <h5 class="mt-3">Trazabilidad Total</h5>
                <p class="text-muted">Registro auditable de cada acción dentro del sistema</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-feature p-4 text-center">
                <i class="bi bi-clock-history display-4 text-warning"></i>
                <h5 class="mt-3">Monitoreo en Tiempo Real</h5>
                <p class="text-muted">Seguimiento de estados y avances de tareas operativas.</p>
            </div>
        </div>
    </div>
</main>

<footer class="footer mt-auto py-3 bg-primary-custom text-white text-center">
    <div class="container">
        <p class="mb-1">&copy; 2026 Sistema de Gestión Vehicular</p>
        <p class="mb-1">
            <i class="bi bi-calendar-check me-1"></i> Fecha del sistema: <span id="fechaActual" class="fw-bold"></span>
        </p>
        <p class="small text-white-50">Control • Seguridad • Reportes</p>
    </div>
</footer>
<script>
    function actualizarFecha() {
        const fecha = new Date();
        const opciones = {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const fechaFormateada = fecha.toLocaleString('es-CL', opciones);
        const elementoFecha = document.getElementById("fechaActual");

        if (elementoFecha) {
            elementoFecha.textContent = fechaFormateada;
        }
    }
    actualizarFecha();
    setInterval(actualizarFecha, 1000);
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>