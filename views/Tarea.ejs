<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= locals.title || 'Crear Nueva Tarea' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #172554;
            --gradient: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
        }

        html, body {
            height: 100%;
            margin: 0;
            background-color: #f8fafc;
            font-family: 'Inter', sans-serif;
            color: #334155;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .content-wrapper {
            flex: 1 0 auto;
        }
        .navbar-custom { 
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1); 
            border-bottom: 3px solid #3b82f6;
        }
        .card-header-custom {
            background: var(--gradient) !important;
            color: #ffffff !important;
            border-bottom: none;
        }
        .form-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 4px solid var(--primary);
        }
        .section-title {
            color: var(--primary);
            font-size: 1.1rem;
            margin-bottom: 15px;
            font-weight: 600;
        }
        .btn-primary-custom {
            background-color: var(--primary);
            border: none;
            color: white;
        }
        .btn-primary-custom:hover { background-color: var(--primary-dark); color: white; }
        .required-field::after {
            content: " *";
            color: #dc3545;
        }
        .bg-primary-custom { 
            background-color: #0f172a !important; 
        }
        footer {
            flex-shrink: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="content-wrapper">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" href="/"><i class="bi bi-kanban-fill me-2 text-primary"></i> Gestor de Tareas</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/tareas">Tareas</a></li>
                        <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link" href="/organizaciones">Organizaciones</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <main class="container mt-4 mb-5">
            <% if (locals.error_msg) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="card shadow border-0">
                        <div class="card-header card-header-custom py-3">
                            <h3 class="mb-0 text-white"><i class="bi bi-plus-square-fill me-2"></i> Registrar Nueva Tarea</h3>
                        </div>
                        <div class="card-body p-4">
                            <form action="/tareas/guardar" method="POST" id="formCrearTarea">
                                <div class="form-section">
                                    <h5 class="section-title"><i class="bi bi-info-circle me-2"></i>1. Información General de la Tarea</h5>
                                    <div class="row">
                                        <!-- CAMPO AGREGADO: Organización requerida por la BD y el Controlador -->
                                        <div class="col-md-12 mb-3">
                                            <label for="id_organizacion" class="form-label fw-bold required-field">Organización</label>
                                            <select class="form-select shadow-sm" id="id_organizacion" name="id_organizacion" required>
                                                <option value="">Seleccione organización...</option>
                                                <% if (locals.organizaciones && organizaciones.length > 0) { %>
                                                    <% organizaciones.forEach(org => { %>
                                                        <option value="<%= org.id_organizacion %>"><%= org.nombre_organizacion %></option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>

                                        <div class="col-md-12 mb-3">
                                            <label for="titulo" class="form-label fw-bold required-field">Título de la Tarea</label>
                                            <input type="text" class="form-control shadow-sm" id="titulo" name="titulo" placeholder="Tarea Operativa" required>
                                        </div>
                                        <div class="col-md-12 mb-3">
                                            <label for="descripcion" class="form-label fw-bold required-field">Descripción del Trabajo</label>
                                            <textarea class="form-control shadow-sm" id="descripcion" name="descripcion" rows="3" placeholder="Detalle los requerimientos técnicos..." required></textarea>
                                        </div>
                                        <div class="col-md-12 mb-3">
                                            <label for="ubicacion_referencial" class="form-label fw-bold required-field">Ubicación Exacta / Referencial</label>
                                            <input type="text" class="form-control shadow-sm" id="ubicacion_referencial" name="ubicacion_referencial" placeholder="Ej: Edificio Torre B, Piso 4, Sala de Servidores - Coordenadas o Sector exacto" required>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-section">
                                    <h5 class="section-title"><i class="bi bi-tags me-2"></i>2. Clasificación, Prioridad y Estado</h5>
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label for="id_categoria" class="form-label fw-bold required-field">Categoría</label>
                                            <select class="form-select shadow-sm" id="id_categoria" name="id_categoria" required>
                                                <option value="">Seleccione categoría...</option>
                                                <% if (locals.categorias && categorias.length > 0) { %>
                                                    <% categorias.forEach(cat => { %>
                                                        <option value="<%= cat.id_categoria %>"><%= cat.nombre_categoria %></option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label for="id_prioridad" class="form-label fw-bold required-field">Prioridad</label>
                                            <select class="form-select shadow-sm" id="id_prioridad" name="id_prioridad" required>
                                                <option value="">Seleccione prioridad...</option>
                                                <% if (locals.prioridades && prioridades.length > 0) { %>
                                                    <% prioridades.forEach(prio => { %>
                                                        <option value="<%= prio.id_prioridad %>"><%= prio.nombre_prioridad %></option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label for="id_estado" class="form-label fw-bold required-field">Estado Inicial</label>
                                            <select class="form-select shadow-sm" id="id_estado" name="id_estado" required>
                                                <option value="">Seleccione estado...</option>
                                                <% if (locals.estados && estados.length > 0) { %>
                                                    <% estados.forEach(est => { %>
                                                        <option value="<%= est.id_estado %>"><%= est.nombre_estado %></option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-section">
                                    <h5 class="section-title"><i class="bi bi-calendar-event me-2"></i>3. Asignación de Personal y Plazos</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="id_usuario_asignado" class="form-label fw-bold required-field">Técnico Asignado</label>
                                            <select class="form-select shadow-sm" id="id_usuario_asignado" name="id_usuario_asignado" required>
                                                <option value="">Seleccione técnico...</option>
                                                <% if (locals.usuarios && usuarios.length > 0) { %>
                                                    <% usuarios.forEach(u => { %>
                                                        <option value="<%= u.id_usuario %>"><%= u.nombre_completo %> (<%= u.rol %>)</option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="porcentaje_avance" class="form-label fw-bold">Porcentaje de Avance Inicial (%)</label>
                                            <input type="number" step="0.01" min="0" max="100" class="form-control shadow-sm" id="porcentaje_avance" name="porcentaje_avance" value="0.00">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="fecha_inicio" class="form-label fw-bold required-field">Fecha de Inicio</label>
                                            <input type="date" class="form-control shadow-sm" id="fecha_inicio" name="fecha_inicio" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="fecha_limite" class="form-label fw-bold required-field">Fecha Límite</label>
                                            <input type="date" class="form-control shadow-sm" id="fecha_limite" name="fecha_limite" required>
                                        </div>
                                        <div class="col-md-12 mb-3">
                                            <label for="observaciones" class="form-label fw-bold required-field">Observaciones Iniciales</label>
                                            <textarea class="form-control shadow-sm" id="observaciones" name="observaciones" rows="2" placeholder="Observaciones..." required>Ninguna</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-section">
                                    <h5 class="section-title"><i class="bi bi-paperclip me-2"></i>4. Subir Evidencia Inicial (Opcional)</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="archivo_evidencia" class="form-label fw-bold">Archivo de Evidencia (Imagen, PDF, etc.)</label>
                                            <input type="file" class="form-control shadow-sm" id="archivo_evidencia" name="archivo_evidencia">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="descripcion_evidencia" class="form-label fw-bold">Descripción de la Evidencia</label>
                                            <input type="text" class="form-control shadow-sm" id="descripcion_evidencia" name="descripcion_evidencia" placeholder="Ej: Estado inicial del equipo antes de reparar">
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between mt-4">
                                    <a href="/tareas" class="btn btn-secondary px-4 shadow-sm">
                                        <i class="bi bi-arrow-left me-2"></i> CANCELAR
                                    </a>
                                    <button type="submit" class="btn btn-primary-custom px-5 shadow-sm fw-bold">
                                        <i class="bi bi-save me-2"></i> GUARDAR TAREA
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <footer class="footer mt-auto py-4 bg-primary-custom text-white text-center border-top border-dark">
        <div class="container">
            <p class="mb-1 fw-medium">&copy; 2026 Sistema de Gestión de Tareas Operativas</p>
            <p class="mb-2">
                <i class="bi bi-calendar-check me-1 text-info"></i> Fecha del sistema: <span id="fechaActual" class="fw-bold"></span>
            </p>
            <p class="small text-white-50 mb-0">Control • Seguridad • Reportes</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function actualizarFecha() {
            const fecha = new Date();
            const opciones = {
                year: 'numeric', month: 'long', day: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            };
            const fechaFormateada = fecha.toLocaleString('es-CL', opciones);
            const elementoFecha = document.getElementById("fechaActual");
            if (elementoFecha) {
                elementoFecha.textContent = fechaFormateada;
            }
        }
        actualizarFecha();
        setInterval(actualizarFecha, 1000);

        document.getElementById('formCrearTarea').addEventListener('submit', function(e) {
            const inicio = new Date(document.getElementById('fecha_inicio').value);
            const limite = new Date(document.getElementById('fecha_limite').value);

            if (limite < inicio) {
                e.preventDefault();
                alert('La fecha límite no puede ser anterior a la fecha de inicio.');
                document.getElementById('fecha_limite').focus();
            }
        });
    </script>
</body>
</html>