<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Iniciar Sesión - Gestor de Tareas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; flex-direction: column; }
        .login-card { border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); border: none; padding: 40px; background: white; }
    </style>
</head>
<body>
    <main class="container my-5 d-flex justify-content-center align-items-center flex-grow-1">
        <div class="card login-card col-12 col-md-4">
            <h3 class="text-center mb-4"><i class="bi bi-box-arrow-in-right text-primary"></i> Iniciar Sesión</h3>
            <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <form action="/auth/login" method="POST">
                <div class="mb-3">
                    <label class="form-label"><i class="bi bi-envelope"></i> Correo Electrónico</label>
                    <input type="email" name="correo" class="form-control" placeholder="usuario@empresa.com" required>
                </div>
                <div class="mb-4">
                    <label class="form-label"><i class="bi bi-lock"></i> Contraseña</label>
                    <input type="password" name="contrasena" class="form-control" placeholder="Ingrese su contraseña" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar
                </button>
            </form>
            <hr class="my-4">
            <p class="text-center mb-0">
                <a href="/auth/registro" class="text-decoration-none">
                    <i class="bi bi-person-plus"></i> ¿No tienes cuenta? Regístrate aquí
                </a>
            </p>
        </div>
    </main>
    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <small>© 2026 Sistema Gestor de Tareas Profesional</small>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>