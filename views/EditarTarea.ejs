<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= locals.title || 'Editar Tarea Operativa' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #172554;
            --gradient: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
        }
        html, body {
            height: 100%; margin: 0; background-color: #f8fafc; font-family: 'Inter', sans-serif; color: #334155;
        }
        body { display: flex; flex-direction: column; min-height: 100vh; }
        .content-wrapper { flex: 1 0 auto; }
        .navbar-custom { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); box-shadow: 0 4px 20px rgba(0,0,0,0.1); border-bottom: 3px solid #3b82f6; }
        .card-header-custom { background: var(--gradient) !important; color: #ffffff !important; border-bottom: none; }
        .form-section { background: #f8f9fa; border-radius: 10px; padding: 20px; margin-bottom: 25px; border-left: 4px solid var(--primary); }
        .section-title { color: var(--primary); font-size: 1.1rem; margin-bottom: 15px; font-weight: 600; }
        .btn-primary-custom { background-color: var(--primary); border: none; color: white; }
        .btn-primary-custom:hover { background-color: var(--primary-dark); color: white; }
        .required-field::after { content: " *"; color: #dc3545; }
        .bg-primary-custom { background-color: #0f172a !important; }
        footer { flex-shrink: 0; width: 100%; }
    </style>
</head>
<body>
    <div class="content-wrapper">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" href="/"><i class="bi bi-kanban-fill me-2 text-primary"></i> Gestor de Tareas</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/tareas">Tareas</a></li>
                        <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link" href="/organizaciones">Organizaciones</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <main class="container mt-4 mb-5">
            <% if (locals.error_msg) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <!-- VALIDACIÓN DE ROL: Solo el usuario Técnico puede modificar la tarea -->
            <% if (locals.usuario && usuario.rol === 'tecnico') { %>
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="card shadow border-0">
                            <div class="card-header card-header-custom py-3 d-flex justify-content-between align-items-center">
                                <h3 class="mb-0 text-white"><i class="bi bi-pencil-square me-2"></i> Modificar Tarea: <%= tarea.codigo_tarea %></h3>
                                <span class="badge bg-info text-dark">Panel Técnico</span>
                            </div>
                            <div class="card-body p-4">
                                <form action="/tareas/actualizar/<%= tarea.id_tarea %>" method="POST" id="formEditarTarea">
                                    <!-- 1. Información General -->
                                    <div class="form-section">
                                        <h5 class="section-title"><i class="bi bi-info-circle me-2"></i>1. Información General</h5>
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label for="titulo" class="form-label fw-bold required-field">Título de la Tarea</label>
                                                <input type="text" class="form-control shadow-sm" id="titulo" name="titulo" value="<%= tarea.titulo %>" required>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label for="descripcion" class="form-label fw-bold required-field">Descripción del Trabajo</label>
                                                <textarea class="form-control shadow-sm" id="descripcion" name="descripcion" rows="3" required><%= tarea.descripcion %></textarea>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label for="ubicacion_referencial" class="form-label fw-bold required-field">Ubicación Exacta / Referencial</label>
                                                <input type="text" class="form-control shadow-sm" id="ubicacion_referencial" name="ubicacion_referencial" value="<%= tarea.ubicacion_referencial %>" required>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- 2. Estado y Avance Técnico -->
                                    <div class="form-section">
                                        <h5 class="section-title"><i class="bi bi-sliders me-2"></i>2. Estado y Progreso de Ejecución</h5>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="id_estado" class="form-label fw-bold required-field">Estado de la Tarea</label>
                                                <select class="form-select shadow-sm" id="id_estado" name="id_estado" required>
                                                    <% if (locals.estados && estados.length > 0) { %>
                                                        <% estados.forEach(est => { %>
                                                            <option value="<%= est.id_estado %>" <%= tarea.id_estado === est.id_estado ? 'selected' : '' %>>
                                                                <%= est.nombre_estado %>
                                                            </option>
                                                        <% }) %>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="porcentaje_avance" class="form-label fw-bold required-field">Porcentaje de Avance (%)</label>
                                                <input type="number" step="0.01" min="0" max="100" class="form-control shadow-sm" id="porcentaje_avance" name="porcentaje_avance" value="<%= tarea.porcentaje_avance %>" required>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- 3. Plazos y Observaciones -->
                                    <div class="form-section">
                                        <h5 class="section-title"><i class="bi bi-calendar-event me-2"></i>3. Plazos y Observaciones de Terreno</h5>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="fecha_inicio" class="form-label fw-bold required-field">Fecha de Inicio</label>
                                                <input type="date" class="form-control shadow-sm" id="fecha_inicio" name="fecha_inicio" value="<%= tarea.fecha_inicio ? tarea.fecha_inicio.toISOString().split('T')[0] : '' %>" required>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="fecha_limite" class="form-label fw-bold required-field">Fecha Límite</label>
                                                <input type="date" class="form-control shadow-sm" id="fecha_limite" name="fecha_limite" value="<%= tarea.fecha_limite ? tarea.fecha_limite.toISOString().split('T')[0] : '' %>" required>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label for="observaciones" class="form-label fw-bold required-field">Observaciones del Técnico</label>
                                                <textarea class="form-control shadow-sm" id="observaciones" name="observaciones" rows="3" required><%= tarea.observaciones %></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-4">
                                        <a href="/tareas" class="btn btn-secondary px-4 shadow-sm"><i class="bi bi-arrow-left me-2"></i> CANCELAR</a>
                                        <button type="submit" class="btn btn-primary-custom px-5 shadow-sm fw-bold"><i class="bi bi-check-circle me-2"></i> ACTUALIZAR TAREA</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="row justify-content-center mt-5">
                    <div class="col-md-8">
                        <div class="alert alert-warning text-center shadow p-5 border-0 rounded-4" role="alert">
                            <i class="bi bi-shield-lock-fill display-3 text-warning mb-3"></i>
                            <h4 class="alert-heading fw-bold">Acceso Restringido</h4>
                            <p class="text-muted mb-4">La modificación y actualización de tareas operativas está reservada exclusivamente para usuarios asignados con rol de <strong>Técnico</strong>.</p>
                            <hr>
                            <a href="/tareas" class="btn btn-dark px-4 mt-2"><i class="bi bi-arrow-left me-2"></i> Volver al Listado General</a>
                        </div>
                    </div>
                </div>
            <% } %>
        </main>
    </div>
    <footer class="footer mt-auto py-4 bg-primary-custom text-white text-center border-top border-dark">
        <div class="container">
            <p class="mb-1 fw-medium">&copy; 2026 Sistema de Gestión de Tareas Operativas</p>
            <p class="mb-2"><i class="bi bi-calendar-check me-1 text-info"></i> Fecha del sistema: <span id="fechaActual" class="fw-bold"></span></p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function actualizarFecha() {
            const fecha = new Date();
            const opciones = { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            const elementoFecha = document.getElementById("fechaActual");
            if (elementoFecha) { elementoFecha.textContent = fecha.toLocaleString('es-CL', opciones); }
        }
        actualizarFecha();
        setInterval(actualizarFecha, 1000);
    </script>
</body>
</html>