<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Registro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: #f0f2f5; min-height: 100vh; display: flex; flex-direction: column; }
        .navbar-custom { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); }
        .reg-container { max-width: 800px; margin-top: 50px; }
        .card-visual { border-radius: 20px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container"><a class="navbar-brand" href="/">Gestor de Tareas</a></div>
    </nav>
    <main class="container reg-container">
        <div class="card card-visual p-4">
            <div class="row">
                <div class="col-md-6 border-end">
                    <h4 class="mb-3">Crear Cuenta</h4>
                    <form action="/auth/registro" method="POST">
                        <input type="hidden" name="id_cliente" value="1">
                        <div class="mb-2"><label>Nombre Completo</label><input type="text" name="nombre_completo" class="form-control" required></div>
                        <div class="mb-2"><label>Correo</label><input type="email" name="correo" class="form-control" required></div>
                        <div class="mb-2"><label>Contraseña</label><input type="password" name="contrasena" class="form-control" required></div>
                        <div class="mb-3"><label>Rol</label><select name="tipo_usuario" class="form-select">
                            <option value="visualizador">Visualizador</option><option value="actualizador">Actualizador</option>
                            <option value="admin_cliente">Admin Cliente</option><option value="super_admin">Super Admin</option>
                        </select></div>
                        <button class="btn btn-success w-100">Registrar</button>
                    </form>
                </div>
                <div class="col-md-6 d-flex flex-column justify-content-center p-4">
                    <div class="card bg-light p-3 border-0">
                        <h5><i class="bi bi-info-circle text-primary"></i> Información</h5>
                        <p class="text-muted">El registro permite centralizar la gestión de tareas operativas, asegurando trazabilidad y control de avance en tiempo real.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <footer class="mt-auto bg-dark text-white text-center py-3">© 2026 Gestor de Tareas</footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>