<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || 'Registro - Sistema Gestor de Tareas' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }
        .register-container {
            width: 100%;
            max-width: 750px;
            margin: auto;
        }
        .register-card {
            border: none;
            border-radius: 20px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        }
        .card-header-custom {
            background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .card-header-custom h2 { font-weight: 700; margin-bottom: 5px; font-size: 1.75rem; }
        .card-header-custom p { margin: 0; opacity: 0.85; font-size: 0.95rem; }
        .card-body { padding: 35px; }
        .form-section {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 4px solid #1e3a8a;
        }
        .section-title {
            color: #1e3a8a;
            font-size: 1.1rem;
            margin-bottom: 15px;
            font-weight: 600;
        }
        .form-label { font-weight: 600; color: #495057; font-size: 0.9rem; margin-bottom: 6px; }
        .form-control, .form-select {
            border-radius: 10px;
            padding: 10px 14px;
            border: 1px solid #ced4da;
            transition: .3s;
        }
        .form-control:focus, .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }
        .input-group-with-icon { position: relative; }
        .input-group-with-icon .bi {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            font-size: 1.1rem;
            pointer-events: none;
        }
        .required-field::after { content: " *"; color: #dc3545; }
        .btn-register {
            background: #1e3a8a;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            color: white;
            transition: .3s;
        }
        .btn-register:hover {
            background: #172554;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(30,58,138,0.3);
            color: white;
        }
        .login-link { color: #1e3a8a; font-weight: 600; text-decoration: none; }
        .login-link:hover { text-decoration: underline; }
        .alert { border-radius: 10px; }
        footer { color: rgba(255,255,255,0.8); text-align: center; font-size: 0.85rem; padding-top: 20px; }
    </style>
</head>
<body>
<div class="register-container">
    <div class="card register-card">
        <div class="card-header-custom">
            <h2><i class="bi bi-kanban-fill me-2"></i>Gestor de Tareas</h2>
            <p>Registro de Organización y Cuenta de Usuario Inicial</p>
        </div>
        <div class="card-body">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <form action="/auth/registro" method="POST" id="formRegistro">
                <div class="form-section">
                    <h5 class="section-title">
                        <i class="bi bi-building me-2"></i>1. Información de la Organización
                    </h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="nombre_organizacion" class="form-label required-field">Nombre Empresa / Organización</label>
                            <div class="input-group-with-icon">
                                <input type="text" class="form-control" id="nombre_organizacion" name="nombre_organizacion" placeholder="Ej: Constructora SpA" required>
                                <i class="bi bi-shop"></i>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="rut_organizacion" class="form-label required-field">RUT Organización</label>
                            <div class="input-group-with-icon">
                                <input type="text" class="form-control" id="rut_organizacion" name="rut_organizacion" placeholder="Ej: 76.123.456-7" required>
                                <i class="bi bi-card-heading"></i>
                            </div>
                            <div class="form-text"><small>Con puntos y guión</small></div>
                        </div>
                    </div>
                </div>
                <div class="form-section">
                    <h5 class="section-title">
                        <i class="bi bi-person-badge me-2"></i>2. Datos del Usuario Administrador
                    </h5>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="nombre_completo" class="form-label required-field">Nombre Completo</label>
                            <div class="input-group-with-icon">
                                <input type="text" class="form-control" id="nombre_completo" name="nombre_completo" placeholder="Ej: Juan Pérez González" required>
                                <i class="bi bi-person"></i>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="rol" class="form-label required-field">Rol</label>
                            <select class="form-select" id="rol" name="rol" required>
                                <option value="administrador" selected>Administrador</option>
                                <option value="supervisor">Supervisor</option>
                                <option value="tecnico">Técnico</option>
                                <option value="visualizador">Visualizador</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="correo" class="form-label required-field">Correo Electrónico (Login)</label>
                            <div class="input-group-with-icon">
                                <input type="email" class="form-control" id="correo" name="correo" placeholder="correo@empresa.cl" required>
                                <i class="bi bi-envelope"></i>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="telefono" class="form-label">Teléfono de Contacto</label>
                            <div class="input-group-with-icon">
                                <input type="tel" class="form-control" id="telefono" name="telefono" placeholder="+56 9 1234 5678">
                                <i class="bi bi-telephone"></i>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="contrasena" class="form-label required-field">Contraseña</label>
                            <div class="input-group-with-icon">
                                <input type="password" class="form-control" id="contrasena" name="contrasena" placeholder="Mínimo 6 caracteres" required minlength="6">
                                <i class="bi bi-lock"></i>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="confirmar_contrasena" class="form-label required-field">Confirmar Contraseña</label>
                            <div class="input-group-with-icon">
                                <input type="password" class="form-control" id="confirmar_contrasena" name="confirmar_contrasena" placeholder="Repita contraseña" required>
                                <i class="bi bi-lock-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-register w-100 py-2">
                    <i class="bi bi-check-circle-fill me-2"></i>Completar Registro y Crear Empresa
                </button>
            </form>
            <div class="text-center mt-3">
                <span class="text-muted">¿Ya tienes una cuenta registrada?</span>
                <a href="/auth/login" class="login-link ms-1">Iniciar Sesión</a>
            </div>
        </div>
    </div>
</div>
<footer>
    <p>&copy; <%= new Date().getFullYear() %> Sistema Gestor de Tareas - Módulo Multi-empresa</p>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('formRegistro').addEventListener('submit', function(e) {
        const pass = document.getElementById('contrasena').value;
        const confirmPass = document.getElementById('confirmar_contrasena').value;
        if (pass !== confirmPass) {
            e.preventDefault();
            alert('Las contraseñas ingresadas no coinciden.');
            document.getElementById('confirmar_contrasena').focus();
        }
    });
</script>
</body>
</html>